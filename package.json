{
  "name": "@singularity2045/image-generator-mcp-server",
  "version": "0.2.1",
  "description": "An MCP server that generates images using GPT Image (gpt-image-1.5) based on text prompts",
  "type": "module",
  "bin": {
    "image-generator": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.1",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.1",
    "openai": "^6.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "supergateway": "^3.4.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^3.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelol/image-generator-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "gpt-image",
    "openai",
    "image-generation",
    "cursor",
    "claude"
  ],
  "author": "Al",
  "license": "MIT"
}
