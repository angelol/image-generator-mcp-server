{
  "name": "@singularity2045/image-generator-mcp-server",
  "version": "0.2.1",
  "description": "An MCP server that generates images using GPT Image (gpt-image-1.5) based on text prompts",
  "type": "module",
  "bin": {
    "image-generator": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.1",
    "dotenv": "^17.2.3",
    "openai": "^6.15.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "supergateway": "^3.4.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelol/image-generator-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "dalle",
    "openai",
    "image-generation",
    "cursor",
    "claude"
  ],
  "author": "Al",
  "license": "MIT"
}
